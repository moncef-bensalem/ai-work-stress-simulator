# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stress_simulator
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ARIA — choix du fournisseur LLM
# auto (défaut) : Gemini > Groq > Ollama > Anthropic > mock
ARIA_PROVIDER=auto

# Option 1 — Groq (GRATUIT, le plus fiable pour ce projet)
# Clé sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Option 2 — Google Gemini (GRATUIT)
# Clé sur https://aistudio.google.com/apikey (format AQ. ou AIza)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 3 — Ollama (100% gratuit, local — installez https://ollama.com)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 4 — Anthropic Claude (PAYANT après crédits gratuits)
ANTHROPIC_API_KEY=
ARIA_MODEL=claude-3-5-haiku-latest

# Admin — email promu automatiquement au rôle admin
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Email SMTP — réinitialisation mot de passe
# Gmail : https://myaccount.google.com/apppasswords (mot de passe d'application, pas le mot de passe Gmail)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
